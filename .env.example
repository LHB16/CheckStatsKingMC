# ==================================================
# BOT SYSTEM CONFIGURATION
# ==================================================

# 1. Chế độ hoạt động (BOT_ROLE):
# - 'master': Chạy trên Render Main (Chỉ chạy Discord Bot & Điều phối Queue)
# - 'worker': Chạy trên các Render Vệ tinh (Chỉ chạy 1 Minecraft Bot AFK + API Server trên IP riêng)
# - 'standalone': (Mặc định) Chạy cả Discord Bot lẫn 1 Minecraft Bot local trên 1 Render duy nhất
BOT_ROLE=standalone

# Secret key để bảo mật kết nối API giữa Master và các Worker (Nếu dùng nhiều Render)
WORKER_SECRET=my_super_secret_key_123

# Danh sách URL Render Workers (Phân cách bởi dấu phẩy, dùng cho Master)
# VÍ DỤ: WORKER_URLS=https://kingmc-worker1.onrender.com,https://kingmc-worker2.onrender.com
WORKER_URLS=

# URL của Master (dùng cho Worker gửi log, báo lỗi về cho Admin)
# VÍ DỤ: MASTER_URL=https://kingmc-master.onrender.com
MASTER_URL=

# ==================================================
# HIGH AVAILABILITY & DUAL MASTER CONFIG (Chạy song song 2 Master)
# ==================================================
# Định danh riêng biệt cho từng Master (VD: 'master-wispbyte', 'master-render')
MASTER_INSTANCE_ID=master-node-01

# Tên hiển thị của Master Node (Dùng để hiển thị trong thông báo Admin và Dashboard)
MASTER_NAME=Master-Primary

# URL Public của chính Node này (VD: https://my-bot.wisp.uno hoặc https://my-bot.onrender.com)
# Khi Master này được bầu làm Leader, nó sẽ tự động đồng bộ URL này lên MongoDB & Google Apps Script
APP_URL=

# Tùy chọn bỏ qua tải Chrome (BẮT BUỘC đặt true khi chạy trên Wispbyte Free Tier để tránh tràn 1 GB Disk)
PUPPETEER_SKIP_DOWNLOAD=false

# Cổng mạng server (Tự động nhận diện SERVER_PORT trên Wispbyte hoặc PORT trên Render)
PORT=3000
SERVER_PORT=3000

# ==================================================
# DISCORD BOT CONFIG (Cần cho Master và Standalone)
# ==================================================
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_test_guild_id_here

# Discord Admin ID để nhận tin nhắn báo lỗi
ADMIN_ID=your_discord_user_id_here

# ==================================================
# MINECRAFT BOT CONFIG (Cần cho Worker và Standalone)
# ==================================================
MC_USERNAME=CheckStatsBot01
MC_AUTH_TYPE=offline
MC_PASSWORD=your_password_here

# Server Fallback List (comma-separated, in order of priority)
MC_SERVER_HOSTS=sgp.kingmc.vn,kingmc.vn
MC_SERVER_PORT=25565

# Rate limit & Timeout configs (ms)
BOT_CHECK_TIMEOUT=15000

# ==================================================
# GROQ AI CHATBOT CONFIG (Xoay vòng API Keys & AI Chat)
# ==================================================
# Danh sách Groq API Keys (Phân cách bởi dấu phẩy để tự động xoay vòng khi hết Quota/Rate Limit)
# Đăng ký lấy API Key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEYS=gsk_key1_here,gsk_key2_here

# Tùy chọn Mô hình AI (Mặc định: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ==================================================
# MONGODB ATLAS (Lưu trữ lịch sử số dư 3 ngày & theo dõi người chơi)
# ==================================================
# Chuỗi kết nối MongoDB Atlas M0 Free
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxx.mongodb.net/kingmc_stats?retryWrites=true&w=majority

